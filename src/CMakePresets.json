{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja-multi",
      "displayName": "Ninja Multi-Config (CI / analysis / default)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (IDE)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build-vs",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "ninja-multi", "configuration": "Release" },
    { "name": "debug", "configurePreset": "ninja-multi", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "test-release",
      "configurePreset": "ninja-multi",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-debug",
      "configurePreset": "ninja-multi",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
