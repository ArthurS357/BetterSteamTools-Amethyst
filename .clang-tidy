# clang-tidy configuration for AmethystTool (M-2 hardening).
#
# Scope: run against the compile_commands.json produced by the ninja-multi
# preset (CMAKE_EXPORT_COMPILE_COMMANDS=ON). HeaderFilterRegex keeps diagnostics
# on OUR headers only — the FetchContent deps under .deps/ and the protobuf/IPC
# code under build/generated/ are third-party/generated and out of scope.
#
# This is a static-analysis *configuration*, not a gate: it was authored in this
# pass but not yet run wholesale over the tree (that is a separate cleanup task).
# WarningsAsErrors is empty so it never blocks a build.
#
# misc-include-cleaner is disabled: it wants every file to include every header it uses
# (AppId_t and the like through WinAPI/Steamworks headers) and made the CI job run for
# over an hour (1h09m on PR #2) without finding a defect.
#
# Several cppcoreguidelines/modernize checks are disabled deliberately: this is
# a DLL-injection + inline-hooking codebase, where reinterpret_cast, pointer
# arithmetic over foreign memory, C-style Win32 varargs and process-wide global
# hook state are the domain, not code smells. Silencing them keeps the signal on
# real defects (see cpp-security / cpp-code-quality).

Checks: >
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  performance-*,
  portability-*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-using,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-make-shared,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-pro-type-member-init,
  -cert-err58-cpp,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -misc-const-correctness,
  -bugprone-branch-clone

# Scope (v1.5.0): diagnostics on headers only for the v1.5.0 code (SteamMetadata and
# tools/); the stable legacy headers (CloudRedirect, Config.h, ...) are not reported.
# Which .cpp files are analysed is decided by the CI job (.github/workflows/ci.yml).
# The magic-number / const-correctness / branch-clone checks are off: they produced
# tens of thousands of findings on legacy code (84k in the PR #3 run) and no defect.
WarningsAsErrors: ''
HeaderFilterRegex: '[\\/](src[\\/]Utils[\\/]SteamMetadata|tools)[\\/].*\.(h|hpp)$'
FormatStyle: file
